  },
  "intro": { "audio": "audio/phrases/intro-k2where.mp3", "text": "Can you find them?" },

  "words": [
    { "id": "bear",     "text": "bear",     "image": "img/animals/bear.png",     "audio": "audio/words/bear.mp3" },
    { "id": "cow",      "text": "cow",      "image": "img/animals/cow.png",      "audio": "audio/words/cow.mp3" },
    { "id": "duck",     "text": "duck",     "image": "img/animals/duck.png",     "audio": "audio/words/duck.mp3" },
    { "id": "monkey",   "text": "monkey",   "image": "img/animals/monkey.png",   "audio": "audio/words/monkey.mp3" },
    { "id": "pig",      "text": "pig",      "image": "img/animals/pig.png",      "audio": "audio/words/pig.mp3" },
