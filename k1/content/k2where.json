    {
      "id": "k2where-choose", "type": "listen-and-choose",
      "items": ["bear","cow","duck","monkey","pig","elephant"],
      "rounds": 6,
      "prompt": { "text": "Where is the {word}?", "audioPattern": "audio/phrases/k2-where-{id}.mp3" },
      "config": { "choices": 3 }
    }
