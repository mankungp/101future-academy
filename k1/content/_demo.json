{
  "id": "_demo",
  "order": 99,
  "title": "Match & Trace (demo)",
  "theme": "test",
  "intro": { "text": "Let's match and trace!" },

  "words": [
    { "id": "apple",  "text": "apple",  "image": "img/fruits/apple.png",  "audio": "audio/words/apple.mp3" },
    { "id": "banana", "text": "banana", "image": "img/fruits/banana.png", "audio": "audio/words/banana.mp3" },
    { "id": "orange", "text": "orange", "image": "img/fruits/orange.png", "audio": "audio/words/orange.mp3" },
    { "id": "grape",  "text": "grape",  "image": "img/fruits/grape.png",  "audio": "audio/words/grape.mp3" },

    { "id": "one",   "text": "one",   "label": "1", "audio": "audio/words/one.mp3",
      "trace": [[0.5,0.2],[0.5,0.42],[0.5,0.62],[0.5,0.82]] },
    { "id": "two",   "text": "two",   "label": "2", "audio": "audio/words/two.mp3",
      "trace": [[0.32,0.34],[0.5,0.22],[0.67,0.34],[0.5,0.56],[0.33,0.78],[0.52,0.8],[0.69,0.8]] },
    { "id": "three", "text": "three", "label": "3", "audio": "audio/words/three.mp3",
