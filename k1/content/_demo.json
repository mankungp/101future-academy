  ],

  "missions": [
    {
      "id": "demo-match-ii",
      "type": "match",
      "items": ["apple","banana","orange","grape"],
      "prompt": { "text": "Match the same pictures!" },
      "config": { "mode": "image-image", "pairs": 4 }
    },
    {
      "id": "demo-match-is",
      "type": "match",
      "items": ["apple","banana","orange","grape"],
      "prompt": { "text": "Tap the {word}!" },
      "config": { "mode": "image-sound", "pairs": 4 }
    },
    {
      "id": "demo-trace",
      "type": "trace",
      "items": ["one","two","three"],
      "prompt": { "text": "Trace the {word}!" }
    }
  ]
}
