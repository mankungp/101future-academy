      "prompt": { "text": "Pop the balloons!", "audioPattern": "audio/words/{id}.mp3" },
      "config": { "render": "balloon" }
    },
    {
      "id": "animals-tap",
      "type": "listen-and-tap",
      "items": ["dog", "cat", "cow", "pig", "duck", "lion", "elephant", "monkey", "frog", "fish", "bird", "bear"],
      "rounds": 12,
      "prompt": { "text": "Tap the {word}!", "audioPattern": "audio/phrases/tap-{id}.mp3" },
      "config": { "choices": 4 }
    }
